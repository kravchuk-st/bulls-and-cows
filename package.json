{
  "name": "bulls-and-cows",
  "version": "1.0.0",
  "description": "Bulls and Cows game written in a functional style",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && http-server . -p 3000 -c-1 -o",
    "dev": "concurrently \"tsc --watch\" \"http-server . -p 3000 -c-1 -o\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html,md}": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kravchuk-st/bulls-and-cows.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/kravchuk-st/bulls-and-cows/issues"
  },
  "homepage": "https://github.com/kravchuk-st/bulls-and-cows#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.0"
  }
}
